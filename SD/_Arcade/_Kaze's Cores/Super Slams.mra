<misterromdescription>
    <name>Super Slams</name>
    <setname>suprslam</setname>
    <rbf>SuperSlams</rbf>
    <mameversion>0289</mameversion>
    <year>1995</year>
    <manufacturer>Banpresto / Toei Animation / Video System Co.</manufacturer>
    <category>Sports</category>

    <!-- OSD defaults: status[23:0], high byte first.  OSD_DEFAULTS in
         tools/build_rom.py.  Editing these three bytes changes what the core
         comes up with, with no rebuild. -->
    <rom index="1">
      <part>00 80 00</part>
    </rom>

    <rom index="0" zip="suprslam.zip" md5="none">
        <!-- maincpu @ 0000000 -->
        <interleave output="16">
          <part name="eb26ic47.bin" crc="8d051fd8" map="12"/>
        </interleave>
        <interleave output="16">
          <part name="eb26ic73.bin" crc="ca4ad383" map="12"/>
        </interleave>
        <!-- audiocpu @ 0100000 -->
        <part name="eb26ic38.bin" crc="153f2c50"/>
        <part repeat="917504">00</part>
        <!-- fgtiles @ 0200000 -->
        <part name="eb26ic43.bin" crc="9dfb0959"/>
        <!-- bgtiles @ 0400000 -->
        <interleave output="16">
          <part name="eb26ic12.bin" crc="14561bd7" map="12"/>
        </interleave>
        <interleave output="16">
          <part name="eb26ic36.bin" crc="92019d89" map="12"/>
        </interleave>
        <!-- sprites @ 0800000 -->
        <interleave output="16">
          <part name="eb26ic09.bin" crc="5a415365" map="12"/>
        </interleave>
        <interleave output="16">
          <part name="eb26ic10.bin" crc="a04f3140" map="12"/>
        </interleave>
        <interleave output="16">
          <part name="eb26_100.bin" crc="c2ee5eb6" map="12"/>
        </interleave>
        <interleave output="16">
          <part name="eb26_101.bin" crc="7df654b7" map="12"/>
        </interleave>
        <!-- adpcma @ 1000000 -->
        <part name="eb26ic66.bin" crc="8cb33682"/>
        <!-- adpcmb @ 1200000 -->
        <part name="eb26ic59.bin" crc="4ae4095b"/>
    </rom>

    <!-- DSW1, DSW2.  Derived in build_rom.py from the SECOND argument of each
         PORT_DIPNAME in suprslam.cpp, not typed by hand.  Demo Sounds
         defaults ON (bit 5 set, active low) and Country defaults to World
         (bit 7 CLEAR, which is the second argument, not the first setting
         listed). -->
    <switches default="FF,7F" base="0">
      <dip name="Coin Slots" bits="0"   ids="Separate,Common"/>
      <dip name="Coin A"     bits="1,3" ids="1C/6C,1C/5C,1C/4C,1C/3C,1C/2C,3C/1C,2C/1C,1C/1C"/>
      <dip name="Coin B"     bits="4,6" ids="1C/6C,1C/5C,1C/4C,1C/3C,1C/2C,3C/1C,2C/1C,1C/1C"/>
      <dip name="Free Play"  bits="7"   ids="On,Off"/>
      <dip name="Difficulty" bits="8,9" ids="Hardest,Hard,Easy,Normal"/>
      <dip name="Play Time"  bits="10,11" ids="5:00,4:00,2:00,3:00"/>
      <dip name="Flip Screen" bits="12" ids="On,Off"/>
      <dip name="Demo Sounds" bits="13" ids="Off,On"/>
      <dip name="Service Mode" bits="14" ids="On,Off"/>
      <dip name="Country"    bits="15"  ids="World,Japan"/>
    </switches>

    <!-- COIN3 (0x04) and SERVICE1 (0x80) are DIFFERENT BITS of suprslam.cpp's
         SYSTEM port.  They shared one button here until the board's own I/O
         TEST was reached, which showed both lighting from a single press.  No
         cabinet's wiring can do that, so it was ours.  TILT gets no pad
         default (a tilt switch is not on the control panel) but is named, so
         the bit is reachable. -->
    <buttons names="Pass,Shoot,Dash,Button 4,Start,Coin,Pause"
             default="A,B,X,Y,Start,Select,R"/>
</misterromdescription>
